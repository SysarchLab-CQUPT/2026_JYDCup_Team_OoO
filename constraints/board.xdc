# Board schematic xc7k325t-V2.1 page 2 ties the Kintex-7 CFGBVS_0 pin to
# VCC3V3, and the configuration flash is powered from the same VCC3V3 rail.
# State those board electrical facts explicitly so Vivado can validate bank 0.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
