set_property PACKAGE_PIN D18 [get_ports i_uart_rx]
set_property IOSTANDARD LVCMOS33 [get_ports i_uart_rx]
set_property PACKAGE_PIN D17 [get_ports o_uart_tx]
set_property IOSTANDARD LVCMOS33 [get_ports o_uart_tx]

# J7 pin 1 / DEBUG_1.  The externally-powered DS18B20 module provides its own
# 10 kohm pull-up to J7 pin 20 (+3.3 V), so no internal pull-up is enabled.
set_property PACKAGE_PIN G17 [get_ports ds18b20_dq_io]
set_property IOSTANDARD LVCMOS33 [get_ports ds18b20_dq_io]
set_property DRIVE 4 [get_ports ds18b20_dq_io]
set_property SLEW SLOW [get_ports ds18b20_dq_io]

set_property PACKAGE_PIN AD12 [get_ports { i_sys_clk_p }]
set_property IOSTANDARD DIFF_HSTL_II_18 [get_ports { i_sys_clk_p }]
set_property PACKAGE_PIN AD11 [get_ports { i_sys_clk_n }]
set_property IOSTANDARD DIFF_HSTL_II_18 [get_ports { i_sys_clk_n }]

# UART RX is asynchronous to clk_soc.  Cut only the external-port path into
# the ASYNC_REG synchronizer; the synchronizer's internal stage-to-stage path
# remains timed.  UART TX and the debug displays have no synchronous external
# sampling clock on the contest board, so their output paths are explicitly
# declared asynchronous board interfaces.
set_false_path -from [get_ports i_uart_rx] \
  -to [get_pins {u_soc/u_peripherals/u_uart/rx_sync_q_reg[0]/D}]
set_false_path -to [get_ports o_uart_tx]
set_false_path -to [get_ports {virtual_led[*]}]
set_false_path -to [get_ports {virtual_seg[*]}]
# The 1-Wire slave response is asynchronous at the pad.  Only the path into
# the first ASYNC_REG stage is cut; the synchronizer and all 50 MHz island
# logic remain timed.  DQ output-enable timing is protocol based, not source
# synchronous to an external clock.
set_false_path -from [get_ports ds18b20_dq_io] \
  -to [get_pins {u_temperature_island/u_sensor/dq_sync_q_reg[0]/D}]
set_false_path -to [get_ports ds18b20_dq_io]
